{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/atomicbox",
      "destination": "/atomicbox/",
      "permanent": true
    },
    {
      "source": "/molbox",
      "destination": "/molbox/",
      "permanent": true
    },
    {
      "source": "/organicbox",
      "destination": "/organicbox/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/atomicbox/",
      "destination": "https://atomicbox.vercel.app/"
    },
    {
      "source": "/atomicbox/:caminho+",
      "destination": "https://atomicbox.vercel.app/:caminho+"
    },
    {
      "source": "/molbox/",
      "destination": "https://supermolbox.vercel.app/"
    },
    {
      "source": "/molbox/:caminho+",
      "destination": "https://supermolbox.vercel.app/:caminho+"
    },
    {
      "source": "/organicbox/",
      "destination": "https://superorganico.vercel.app/"
    },
    {
      "source": "/organicbox/:caminho+",
      "destination": "https://superorganico.vercel.app/:caminho+"
    }
  ]
}
